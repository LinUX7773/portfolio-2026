---
import Flower from '../components/decor/Flower.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  nb: {
    title: 'Mentoring',
    description: 'Lin Bele Jacobsen er mentor for juniore UX-designere og produktledere gjennom ADPList.',
    heading: 'De unge og ambisiøse',
    meta: [
      ['Rolle', 'Mentor'],
      ['Økter', '104'],
      ['Periode', 'jan. 2022 – pågår'],
      ['Selskap', 'ADPList'],
    ],
    takeawaysHeading: 'Dette lærte jeg',
    takeaways: 'Å være mentor har vært det mest givende og inspirerende grepet i karrieren min.',
    cardAlt:
      'Mentorkortet til Lin Bele Jacobsen på ADPList: tidssone, rollen som UX Lead i Experis, 108 økter og 35 anmeldelser, og en knapp med teksten «Book a session with me».',
    rest1: [
      'De unge og svært ambisiøse menteene deler modig problemene og bekymringene sine. Jeg stiller spørsmål, hjelper dem med å sortere bekymringene og legger en strategi for å løse problemene.',
      'Vi snakker ofte om hvordan man kommuniserer effektivt.',
      'Jeg holder også prøveintervjuer og gir tilbakemelding på porteføljer.',
    ],
    profileAlt:
      'Den fullstendige ADPList-profilen til Lin Bele Jacobsen: en Om meg-oppsummering, statistikk som viser 4 605 minutter med mentoring og 104 gjennomførte økter, profilmerker som Clear Communicator, Interacts with newbies, Perfect Presence og Top achiever: Lead, og en liste over tilgjengelige økttyper.',
    rest2: [
      'De siste tre årene har jeg vært mentor for juniore UX/UI-designere og produktledere. Det er gøy og givende å være mentor, og det har tent gnisten for design og produktledelse på nytt. Som mentor gir jeg tips om hvordan man kommer inn i bransjen og hva man kan forvente. Jeg hjelper med CV, portefølje og intervjutrening.',
      'Jeg har også ganske mange faste mentees som vil ha noen å sparre med når de er den eneste designeren i selskapet. Jeg har lært utrolig mye av disse samtalene, og jeg er imponert over at ADPList legger til rette for alt dette gratis. Ingen penger skifter hender, bare ideer og inspirasjon. Dette skjer på kveldstid.',
    ],
    statsAlt:
      'Et statistikkort fra ADPList: 4 605 minutter med mentoring, 104 1:1-avtaler og mentees fra 25 land, med en tabell der Norge (38), Storbritannia (16), Polen (7) og India (6) ligger øverst.',
    reviewsAlt: [
      'Tre anmeldelser fra ADPList, oversatt fra engelsk. Stephen Michetti, digital produktdesigner (frilans), 22. juli 2024: «Lin var veldig oppmerksom og hjelpsom, lyttet til meg og ga meg retning. Jeg holder gjerne kontakten og forteller henne hvordan det går.» Ellen Depaemelaere, student ved Universitetet i Antwerpen, 2. juli 2024: «Jacobsen har dyp kunnskap om ulike IT-felt, men vet godt å skille dem fra hverandre … Hun var svært oppmerksom, sørget for å forstå helheten og viste tålmodighet.» Christian, UX-leder i BrightLocal, 24. juni 2024: «Lin hadde et flott perspektiv på det å jobbe i tech og på avstand. Det var interessant å høre om utfordringene akkurat nå, og å få noen ideer om hvordan man kan vise og tilføre verdi. Jeg gikk derfra inspirert.»',
      'To anmeldelser fra ADPList, oversatt fra engelsk. Erin Tan, UX-designer på jakt etter nye muligheter, 20. februar 2024: «Jeg elsker alltid øktene våre! De er alltid oppmuntrende og gir energi, fordi Lin viser stor lidenskap for jobben sin og gir struktur og konkrete tips.» Sara Ghasemian, produktdesign i Farakaranet, 12. februar 2024: «Etter møtet vårt er jeg takknemlig for mentorens oppmuntring og positive holdning.»',
      'Tre anmeldelser fra ADPList, oversatt fra engelsk. Alissa Marr, produkt-UX-designer i grunnleggerteamet i trender.ai, 20. desember 2023: «Økten med Lin var virkelig oppløftende. Vi snakket mye om karrierene våre og de ulike prosjektene vi har jobbet med, prosessene våre og kursendringene våre … Porteføljegjennomgangen ga meg selvtillit og var også veldig nyttig, siden hun pekte på konkrete detaljer jeg kunne prøve ut. Alt i alt en hyggelig prat.» Marina Kraus, senior UX/UI-designer i Urbio, 14. desember 2023: «Jeg hadde en flott samtale med Lin. Hun ga meg svært gode tips om hvordan jeg best kan bygge innsiktsarbeid inn i arbeidsflyten som eneste designer, uten å bruke for mye tid på det … Jeg kan varmt anbefale henne som en å snakke med om jobben som UX-designer.» Yaowei Rui, UX-designer i Food For Thought, 13. november 2023: «Lin er en veldig oppriktig mentor med mange års UX-erfaring. Hun ga meg ærlige tilbakemeldinger på CV og portefølje, med en tydelig og konstruktiv UX-tilnærming. Takk, Lin!»',
    ],
  },
  en: {
    title: 'Mentoring',
    description: 'Lin Bele Jacobsen mentors junior UX designers and product managers through ADPList.',
    heading: 'The young and ambitious',
    meta: [
      ['Roles', 'Mentor'],
      ['Sessions', '104'],
      ['Time', 'Jan 2022 – ongoing'],
      ['Company', 'ADPList'],
    ],
    takeawaysHeading: 'My key takeaways',
    takeaways: 'Being a mentor has been the most rewarding and inspiring move of my career.',
    cardAlt:
      'An ADPList mentor card for Lin Bele Jacobsen: her timezone, her role as UX Lead at Experis, 108 sessions and 35 reviews, with a "Book a session with me" button.',
    rest1: [
      'The young and highly ambitious mentees bravely share their problems and concerns. I ask questions and help them compartmentalise their concerns and lay a strategy for solving problems.',
      'We often discuss how to communicate efficiently.',
      'I also do mock interviews and help with portfolio reviews.',
    ],
    profileAlt:
      "Lin Bele Jacobsen's full ADPList profile page: an About Me summary, community statistics showing 4,605 minutes mentored and 104 sessions completed, profile insight badges including Clear Communicator, Interacts with newbies, Perfect Presence and Top achiever: Lead, and a list of available session types.",
    rest2: [
      'For the past 3 years I have been working as a mentor for junior UX-UI designers and PMs. Being a mentor is fun and rewarding. It has re-sparked my passion for design and product management. As a mentor, I offer tips on how to get into the industry and what to expect. I help with CV, portfolio, and interview training.',
      'I also have quite a few regular mentees who want someone to kick a ball with when being the only designer in a company. I learned so much from these sessions and I am impressed by ADPList for facilitating all this for free. No money changes hands, only ideas and inspiration. This activity happens during evenings.',
    ],
    statsAlt:
      'An ADPList community-statistics card: 4,605 minutes mentored, 104 1:1 bookings, and 25 countries mentored, with a breakdown table led by Norway (38), the United Kingdom (16), Poland (7) and India (6).',
    reviewsAlt: [
      'Three ADPList reviews. Stephen Michetti, Digital Product Designer (Freelance), 22 July 2024: "Lin was very attentive and helpful in hearing me out and giving me direction. I\'ll gladly stay in touch and let her know how I get along." Ellen Depaemelaere, student at University of Antwerp, 2 July 2024: "Miss Jacobsen has profound knowledge in various IT fields, but knows very well how to distinguish them... She came across as very alert, made sure she understood the whole picture and showed patience." Christian, UX Manager at BrightLocal, 24 June 2024: "Lin had a great perspective on working in tech and remotely. It was interesting to hear about the challenges out there right now and also get some ideas on how to show and add value. I came away feeling inspired."',
      'Two ADPList reviews. Erin Tan, UX Designer looking for opportunities, 20 February 2024: "I always love our sessions together! They are always encouraging and invigorating because Lin shows great passion for her work and provides structure and actionable tips." Sara Ghasemian, product design at Farakaranet, 12 February 2024: "After our meeting, I\'m thankful for my mentor\'s encouragement and positive attitude."',
      'Three ADPList reviews. Alissa Marr, Product UX Designer on the founding team at trender.ai, 20 December 2023: "My session with Lin was really uplifting. We talked a lot about our careers and the different projects we have worked on, our processes and our pivots... The portfolio review was empowering and also very helpful as she noted detailed additives I might want to try. Overall a lovely chat." Marina Kraus, Senior UX/UI Designer at Urbio, 14 December 2023: "I had a great conversation with Lin. She gave me extremely good tips on how to best incorporate UXR into my workflow as a solo designer without spending too much time on it... I can highly recommend her as someone to talk to about your work as a UX designer." Yaowei Rui, UX Designer at Food For Thought, 13 November 2023: "Lin is a very genuine mentor with many years of UX experience. She provided me with honest feedback on my resume and portfolio, approaching it with a clear, constructive UX mindset. Thank you, Lin!"',
    ],
  },
}[lang];

const reviews = [
  { src: '/assets/mentoring/review-michetti-depaemelaere-christian.png', width: 1576, height: 1926 },
  { src: '/assets/mentoring/review-tan-ghasemian.png', width: 1700, height: 1062 },
  { src: '/assets/mentoring/review-marr-kraus-rui.png', width: 1658, height: 1908 },
];
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main" class="page-main">
    <div class="page-grid mentoring-page">
      <div class="page-grid__reading mentoring__copy">
        <p class="kicker">{copy.title}</p>
        <div class="mentoring__title-row">
          <div class="mentoring__decor" aria-hidden="true">
            <Flower name="bluebell" />
          </div>
          <h1>{copy.heading}</h1>
        </div>

        <dl class="meta">
          {
            copy.meta.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="page-grid__reading mentoring__intro">
        <div class="prose">
          <h2>{copy.takeawaysHeading}</h2>
          <p>{copy.takeaways}</p>
        </div>

        <figure class="mentoring__card">
          <img
            src="/assets/mentoring/adplist-profile-card.png"
            alt={copy.cardAlt}
            width="1004"
            height="770"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="page-grid__reading mentoring__rest">
        <div class="prose">
          {copy.rest1.map((paragraph) => <p>{paragraph}</p>)}

          <figure>
            <img
              src="/assets/mentoring/adplist-full-profile.png"
              alt={copy.profileAlt}
              width="3158"
              height="2428"
              loading="lazy"
              decoding="async"
            />
          </figure>

          {copy.rest2.map((paragraph) => <p>{paragraph}</p>)}

          <figure>
            <img
              src="/assets/mentoring/mentoring-stats.png"
              alt={copy.statsAlt}
              width="1836"
              height="512"
              loading="lazy"
              decoding="async"
            />
          </figure>

          {
            reviews.map((review, index) => (
              <figure>
                <img
                  src={review.src}
                  alt={copy.reviewsAlt[index]}
                  width={review.width}
                  height={review.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .mentoring-page {
    row-gap: var(--space-4);
  }

  /*
   * Grid, not flex-wrap: the heading text is long enough to need two lines
   * on its own at large sizes, and a wrapping flex row would then decide
   * (based on the H1's unwrapped max-content width, before any shrinking)
   * that the flower doesn't fit beside it and push it onto its own line
   * entirely above the heading. A two-column grid has no such ambiguity —
   * the flower keeps its own auto-sized column and the heading wraps
   * freely within the remaining column.
   *
   * The flower used to stretch to match the heading's own wrapped height
   * (via align-self: stretch + aspect-ratio on .mentoring__decor). That
   * put the grid row's auto-height in a circular dependency with the
   * flower's own intrinsic sizing, and at some viewport widths — where
   * the heading wraps to two lines but the row was still sized as if it
   * were one — the row collapsed short and the next block (the meta grid)
   * rendered on top of the second heading line and the bottom of the
   * flower. A fixed height (matching the pattern already used on the
   * About and Resume pages) has no such dependency.
   */
  .mentoring__title-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    column-gap: 1.25rem;
  }

  .mentoring__decor {
    height: clamp(5.5rem, 11vw, 9rem);
    pointer-events: none;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .meta {
    display: grid;
    gap: 1rem;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .meta dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
  }

  /* Adds to the grid's row-gap so the meta strip sits one --section-gap
     above "My key takeaways". */
  .mentoring__intro .prose {
    margin-top: calc(var(--section-gap) - var(--space-4));
  }

  /*
   * Experimental placement: the contact card sits beside the first "My
   * key takeaways" paragraph instead of inline in the reading column.
   * At desktop it's taken out of flow (position: absolute, anchored to
   * .mentoring__intro) so its own height never affects the row height —
   * growing or shrinking the card can't push the rest of the page's
   * content down, and the reading column's text isn't constrained by it
   * either. Below the 1100px rail breakpoint there's no rail to float
   * into, so it drops back into normal flow, stacked below the text.
   */
  .mentoring__intro {
    position: relative;
  }

  .mentoring__card {
    margin: 0;
    width: 100%;
    max-width: 14.04rem;
  }

  @media (min-width: 1100px) {
    .mentoring__card {
      position: absolute;
      /* Aligns the card with the first paragraph: the .prose offset, one
         line of H2 and the heading gap. */
      top: calc(var(--section-gap) - var(--space-4) + var(--step-2) * 1.15 + var(--heading-gap));
      left: calc(100% + var(--gutter));
    }
  }

  /*
   * Below the rail breakpoint the card drops into normal flow directly
   * after .prose. .prose zeroes its children's bottom margins, so the
   * card needs its own explicit spacing here.
   */
  @media (max-width: 1099px) {
    .mentoring__card {
      margin-top: var(--space-4);
    }
  }

  @media (min-width: 500px) {
    .meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
