---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main" class="page-main">
    <div class="page-grid mentoring-page">
      <div class="page-grid__reading mentoring__copy">
        <p class="kicker">{copy.title}</p>
        <div class="mentoring__title-row">
          <div class="mentoring__decor" aria-hidden="true">
            <Flower name="bluebell" />
          </div>
          <h1>{copy.heading}</h1>
        </div>

        <dl class="meta">
          {
            copy.meta.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="page-grid__reading mentoring__body">
        <div class="prose">
          <h2>{copy.takeawaysHeading}</h2>
          <figure class="media-float">
            <img
              src="/assets/mentoring/adplist-profile-card.png"
              alt={copy.cardAlt}
              width="1004"
              height="770"
              decoding="async"
            />
          </figure>
          <p>{copy.takeaways}</p>
          {copy.rest1.map((paragraph) => <p>{paragraph}</p>)}

          <figure>
            <img
              src="/assets/mentoring/adplist-full-profile.png"
              alt={copy.profileAlt}
              width="3158"
              height="2428"
              loading="lazy"
              decoding="async"
            />
          </figure>

          {copy.rest2.map((paragraph) => <p>{paragraph}</p>)}

          <figure>
            <img
              src="/assets/mentoring/mentoring-stats.png"
              alt={copy.statsAlt}
              width="1836"
              height="512"
              loading="lazy"
              decoding="async"
            />
          </figure>

          {
            reviews.map((review, index) => (
              <figure>
                <img
                  src={review.src}
                  alt={copy.reviewsAlt[index]}
                  width={review.width}
                  height={review.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .mentoring-page {
    row-gap: var(--space-4);
  }

  /*
   * Grid, not flex-wrap: the heading text is long enough to need two lines
   * on its own at large sizes, and a wrapping flex row would then decide
   * (based on the H1's unwrapped max-content width, before any shrinking)
   * that the flower doesn't fit beside it and push it onto its own line
   * entirely above the heading. A two-column grid has no such ambiguity —
   * the flower keeps its own auto-sized column and the heading wraps
   * freely within the remaining column.
   *
   * The flower used to stretch to match the heading's own wrapped height
   * (via align-self: stretch + aspect-ratio on .mentoring__decor). That
   * put the grid row's auto-height in a circular dependency with the
   * flower's own intrinsic sizing, and at some viewport widths — where
   * the heading wraps to two lines but the row was still sized as if it
   * were one — the row collapsed short and the next block (the meta grid)
   * rendered on top of the second heading line and the bottom of the
   * flower. A fixed height (matching the pattern already used on the
   * About and Resume pages) has no such dependency.
   */
  .mentoring__title-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    column-gap: 1.25rem;
  }

  .mentoring__decor {
    height: clamp(5.5rem, 11vw, 9rem);
    pointer-events: none;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .meta {
    display: grid;
    gap: 1rem;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .meta dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
  }

  /* Adds to the grid's row-gap so the meta strip sits one --section-gap
     above "My key takeaways". */
  .mentoring__body .prose {
    margin-top: calc(var(--section-gap) - var(--space-4));
  }

  @media (min-width: 500px) {
    .meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
