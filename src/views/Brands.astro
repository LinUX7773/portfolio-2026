---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = (nb: string, en: string, ko: string) => ({ nb, en, ko })[lang];
const link = (path: string) => localePath(lang, path);

interface BrandItem {
  name: string;
  href?: string;
}

interface BrandGroup {
  heading: string;
  items: BrandItem[];
}

const copy = {
  nb: {
    title: 'Kunder og bransjer',
    description: 'Virksomheter og organisasjoner Lin Bele Jacobsen har jobbet med, gruppert etter bransje.',
    intro: 'Dette er virksomhetene jeg har hatt gleden av å jobbe med gjennom karrieren min.',
  },
  en: {
    title: 'Brands & Industries',
    description: 'Brands and organisations Lin Bele Jacobsen has worked with, grouped by industry.',
    intro: 'These are the brands and companies I have had the privilege to work with along my career.',
  },
  ko: {
    title: '고객사와 산업',
    description: 'Lin Bele Jacobsen이 함께 일한 기업과 기관을 산업별로 정리했습니다.',
    intro: '지금까지 경력을 쌓으며 함께 일할 수 있었던 기업과 기관들입니다.',
  },
}[lang];

const groups: BrandGroup[] = [
  {
    heading: tr('Varehandel', 'Retail', '유통'),
    items: [
      { name: 'NorgesGruppen', href: link('/projects/the-grocer') },
      { name: 'Asko' },
      { name: 'Akademika' },
    ],
  },
  {
    heading: tr('Logistikk', 'Logistics', '물류'),
    items: [{ name: 'Bring' }, { name: tr('Posten Norge', 'Norwegian Post', '노르웨이 우정청 (Posten Norge)') }],
  },
  {
    heading: tr('Offentlig sektor', 'Public sector / Government', '공공 부문'),
    items: [
      { name: tr('Landbruksdirektoratet', 'Directorate of Agriculture', '노르웨이 농업청') },
      {
        name: tr('Meteorologisk institutt', 'Norwegian Meteorological Institute', '노르웨이 기상청'),
        href: link('/projects/the-weather-in-malawi'),
      },
      { name: tr('Posten Norge', 'Norwegian Post', '노르웨이 우정청 (Posten Norge)') },
      { name: tr('Datatilsynet', 'Norwegian Data Protection Authority (DPA)', '노르웨이 개인정보보호청') },
      { name: tr('Skatteetaten', 'Norwegian Tax Administration', '노르웨이 국세청') },
      {
        name: tr(
          'Malawis direktorat for klimaendringer og meteorologi (DCCMS)',
          'The Department of Climate Change and Meteorological Services of Malawi',
          '말라위 기후변화·기상청 (DCCMS)',
        ),
        href: link('/projects/the-weather-in-malawi'),
      },
    ],
  },
  {
    heading: tr('Utdanning og læring', 'Education and learning', '교육과 학습'),
    items: [{ name: 'Pearson' }, { name: 'Fronter' }, { name: 'ADPList', href: link('/mentoring') }],
  },
  {
    heading: tr('Humanitære og ideelle organisasjoner', 'Humanitarian organization / charity / NGOs', '인도주의·비영리 단체'),
    items: [
      { name: tr('Røde Kors', 'Red Cross', '적십자') },
      { name: tr('Redd Barna', 'Save the Children', '세이브더칠드런'), href: link('/projects/the-weather-in-malawi') },
      { name: 'Norcap' },
      {
        name: tr('Verdens meteorologiorganisasjon (FN)', 'World Meteorological Organization (UN)', '세계기상기구 (UN)'),
        href: link('/projects/the-weather-in-malawi'),
      },
    ],
  },
  {
    heading: tr('Annet', 'Other', '기타'),
    items: [
      { name: '1881.no', href: link('/projects/car-owner') },
      { name: 'VIRKE' },
      { name: 'KPMG' },
      { name: 'Trysilhus' },
      { name: 'Vysus Group' },
      { name: 'iSonen' },
    ],
  },
  {
    heading: tr('IT-bransjen', 'IT industry', 'IT 산업'),
    items: [
      { name: 'Tieto Evry' },
      { name: 'Buypass' },
      { name: 'Syscom' },
      { name: 'Bosch Global Software Technologies' },
      { name: 'Kongsberg Digital' },
      { name: 'Ness' },
      { name: 'Experis' },
      { name: 'Kantega' },
      { name: 'Northern Beat' },
      { name: 'Pureservice', href: link('/projects/service-management') },
    ],
  },
  {
    heading: tr('Landbruk', 'Farming', '농업'),
    items: [
      { name: 'Mimiro', href: link('/projects/farmers') },
      { name: tr('Landbruksdirektoratet', 'Directorate of Agriculture', '노르웨이 농업청') },
    ],
  },
  {
    heading: tr('Telekom', 'Telecom', '통신'),
    items: [{ name: 'Telia' }],
  },
];
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main" class="page-main">
    <div class="site-frame brand-page">
      <h1>{copy.title}</h1>

      <p class="brand-intro">{copy.intro}</p>

      <div class="brand-wall">
        {
          groups.map((group, index) => (
            <section class="brand-group" aria-labelledby={`group-${index}`}>
              <h2 id={`group-${index}`}>{group.heading}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    {item.href ? <a href={item.href}>{item.name}</a> : item.name}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .brand-page {
    padding-top: var(--space-3);
  }

  h1 {
    max-width: 40rem;
    margin: 0 auto;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    line-height: 1;
    text-align: center;
  }

  .brand-wall {
    column-gap: var(--space-6);
    columns: 1;
  }

  .brand-group {
    break-inside: avoid;
    margin-bottom: var(--space-5);
  }

  .brand-group h2 {
    margin: 0 0 var(--heading-gap);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
  }

  .brand-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-group li {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .brand-group a {
    color: var(--ink-soft);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .brand-group a:hover,
  .brand-group a:focus-visible {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .brand-intro {
    max-width: 28rem;
    margin: var(--space-4) auto var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink-soft);
    text-align: center;
  }

  @media (min-width: 640px) {
    .brand-wall {
      columns: 2;
    }
  }

  /*
   * At large desktop, three columns read as one centred editorial block
   * instead of spreading across the full page width: same centred-wide
   * container formula used for the masthead, footer and the media-wide
   * case-study images (reading column + one rail's worth of width,
   * centred), rather than an arbitrary margin or transform.
   */
  @media (min-width: 1100px) {
    .brand-wall {
      columns: 3;
      column-gap: var(--space-5);
      width: calc((var(--reading-w) + 100%) / 2 - var(--gutter));
      margin-inline: auto;
    }
  }
</style>
