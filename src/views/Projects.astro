---
import ProjectRow from '../components/ProjectRow.astro';
import Flower from '../components/decor/Flower.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
import { localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);

const copy = {
  nb: {
    title: 'Prosjekter',
    description: 'UX-prosjekter av Lin Bele Jacobsen.',
    kicker: 'Arbeid',
    intro:
      'Jeg elsker å finne kompliserte oppgaver som lar seg automatisere, slik at brukerne kan bruke mer tid på det som er gøy og gir høy verdi! Her er noen prosjekter der jeg fikk jobbe med akkurat det.',
  },
  en: {
    title: 'Projects',
    description: 'UX case studies by Lin Bele Jacobsen.',
    kicker: 'Work',
    intro:
      "I love finding complicated tasks that can be automated, so users can spend more time on what's fun and valuable! Here are a few projects where I got to work on exactly that.",
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main" class="page-main">
    <div class="page-grid projects-page">
      <header class="page-grid__reading page-head">
        <p class="kicker">{copy.kicker}</p>
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
      </header>

      <div class="page-grid__reading list">
        {
          projects.map(({ entry, slug }) => (
            <ProjectRow
              href={localePath(lang, `/projects/${slug}`)}
              title={entry.data.title}
              summary={entry.data.summary}
              topics={entry.data.topics}
            />
          ))
        }
      </div>

      <div class="projects-page__decor" aria-hidden="true">
        <Flower name="daisy" />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .projects-page {
    position: relative;
  }

  .projects-page__decor {
    position: absolute;
    z-index: 0;
    bottom: -1.75rem;
    right: -1rem;
    height: clamp(5.5rem, 11vw, 8rem);
    pointer-events: none;
  }

  .page-head {
    margin-bottom: var(--space-5);
  }

  h1 {
    margin: 0.25em 0 0.45em;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .page-head p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
