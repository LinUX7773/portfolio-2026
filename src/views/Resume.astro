---
import Flower from '../components/decor/Flower.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  nb: {
    title: 'CV',
    description: 'Yrkeserfaring, ferdigheter og kurs for Lin Bele Jacobsen, UX/UI-designer og Product Owner.',
    heading: 'Yrkeserfaring',
    intro:
      'Jeg er UX/UI-designer og Product Owner med over 14 års internasjonal erfaring. Jeg er spesielt opptatt av å designe verktøy for folk på jobb. Jeg vil forstå hvordan folk bruker dagen sin. Hva tar tid? Hva avbryter flyten? Hva liker de, og hva føles repetitivt? Derfra kan vi se hva som kan automatiseres, og hva som bør overlates til mennesker. Jeg startet karrieren som utvikler. Den tekniske bakgrunnen preger fortsatt hvordan jeg jobber med utviklere og tilnærmer meg design.',
    chartAlt:
      'Et stolpediagram over antall års erfaring per område: bransjeerfaring, 28 år; UX-designer, 21 år; smidig Product Owner, 10 år; utvikler, 5 år; UI-design, 4 år; webanalytiker, 3 år.',
  },
  en: {
    title: 'Resume',
    description:
      'The professional experience, skills and training of Lin Bele Jacobsen, UX/UI designer and product owner.',
    heading: 'Professional experience',
    intro:
      "I'm a UX/UI Designer and Product Owner with over 14 years of international experience. I'm especially interested in designing tools for people at work. I want to understand how people spend their day. What takes time? What interrupts their flow? What do they enjoy, and what feels repetitive? From there, we can see what could be automated and what is better left to people. I started my career as a developer. That technical background still shapes how I work with engineers and approach design.",
    chartAlt:
      'A bar chart breaking down years of experience by area: Industry, 28 years; UX Designer, 21 years; Agile PO, 10 years; Developer, 5 years; UI Design, 4 years; Web Analyst, 3 years.',
  },
  ko: {
    title: '이력서',
    description: 'UX/UI 디자이너이자 프로덕트 오너인 Lin Bele Jacobsen의 경력, 역량, 교육 이력입니다.',
    heading: '경력',
    intro:
      '저는 14년 이상의 국제 경험을 가진 UX/UI 디자이너이자 프로덕트 오너입니다. 특히 일하는 사람들을 위한 도구를 디자인하는 데 관심이 많습니다. 사람들이 하루를 어떻게 보내는지 이해하고 싶습니다. 무엇에 시간이 걸리나요? 무엇이 흐름을 방해하나요? 무엇을 즐기고, 무엇이 반복적으로 느껴지나요? 여기서부터 무엇을 자동화할 수 있고 무엇을 사람에게 맡기는 것이 좋은지 알 수 있습니다. 저는 개발자로 커리어를 시작했습니다. 그 기술적 배경은 지금도 엔지니어와 협업하고 디자인에 접근하는 방식에 영향을 줍니다.',
    chartAlt:
      '분야별 경력 연수를 보여 주는 막대그래프: 업계 28년, UX 디자이너 21년, 애자일 PO 10년, 개발자 5년, UI 디자인 4년, 웹 분석가 3년.',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main" class="page-main">
    <div class="page-grid resume-page">
      <div class="page-grid__reading resume__copy">
        <p class="kicker">{copy.title}</p>
        <div class="resume__title-row">
          <div class="resume__decor" aria-hidden="true">
            <Flower name="snowdrop" />
          </div>
          <h1>{copy.heading}</h1>
        </div>
      </div>

      <div class="page-grid__reading resume__intro">
        <div class="prose">
          <figure class="media-float">
            <img
              src="/assets/resume/experience-chart.png"
              alt={copy.chartAlt}
              width="1402"
              height="1638"
              decoding="async"
            />
          </figure>
          <p>{copy.intro}</p>
        </div>
      </div>

      <div class="page-grid__reading resume__rest">
        <div class="prose">
          {
            lang === 'nb' ? (
              <Fragment>
              <h2>Erfaring</h2>

              <h3>UX-designer, UX-researcher og Scrum Master — Felleskjøpet</h3>
              <p class="role-dates">2024 – nå</p>
              <ul>
                <li>
                  <strong>Netthandel på flere nettsteder:</strong> jobbet med redesign og videreutvikling av
                  Felleskjøpets netthandelsplattform på Optimizely Headless CMS, lansert i desember 2025.
                </li>
                <li>
                  <strong>Brukerinnsikt:</strong> kombinerte kvalitativ innsikt med GA4, Hotjar, søkedata og innsikt
                  fra kundeservice for å avdekke brukerbehov og prioritere forbedringer.
                </li>
                <li>
                  <strong>Innsiktsforum:</strong> etablerte og ledet et tverrfaglig forum der UX, analyse, SEO, søk og
                  kundeservice deler funn og samordner prioriteringer.
                </li>
                <li>
                  <strong>Smidig leveranse:</strong> fasiliterte refinement og detaljering på tvers av frontend,
                  backend, design og test, og hjalp teamet med å bryte større funksjoner ned i gjennomførbare oppgaver.
                </li>
                <li>
                  <strong>Produktsamarbeid:</strong> jobbet tett med utviklere, designere og interessenter for å
                  balansere brukerbehov, forretningsmål og tekniske begrensninger.
                </li>
              </ul>

              <h3>UX Lead og Product Owner — Experis, Anyshore</h3>
              <p class="role-dates">2021 – nå</p>
              <ul>
                <li>
                  <strong>Oslo kommune:</strong> gjennomførte tilgjengelighetstester og ga anbefalinger for universell
                  utforming basert på WCAG.
                </li>
                <li>
                  <strong>Meteorologisk institutt:</strong> ledet UX/UI-design og produkteierskap for et værapp-prosjekt
                  i Malawi, med brukerinnsikt og high-fidelity-design.
                </li>
                <li>
                  <strong>Buypass AS:</strong> ledet designteamet, satte designstrategi og bygde en innsiktsbank.
                </li>
                <li>
                  <strong>Landbruksdirektoratet:</strong> utviklet UI-design og en oppfrisking av den visuelle
                  profilen, med et designsystem med Figma-komponenter.
                </li>
                <li>
                  <strong>Skatteetaten:</strong> kartla viktige resultatindikatorer på tvers av avdelinger og intervjuet
                  40 ledere for å gjøre driften mer effektiv.
                </li>
              </ul>

              <h3>UX Lead og Product Owner — Mimiro</h3>
              <p class="role-dates">2019 – 2020</p>
              <ul>
                <li>Ledet UX-design og produkteierskap for et team på 20 utviklere på distanse, og laget datadrevne verktøy for bønder.</li>
                <li>Tok i bruk avansert teknologi som lydanalyse, GPS, gyroskop og maskinlæring for å effektivisere matproduksjonen.</li>
              </ul>

              <h3>Senior UX-designer (konsulent) — Northern Beat</h3>
              <p class="role-dates">2016 – 2019</p>
              <ul>
                <li>
                  <strong>Skatteetaten:</strong> utviklet og innførte strategier for informasjonsarkitektur. Skrev klare
                  og konsise tekster for å styrke brukernes forståelse og engasjement.
                </li>
                <li>
                  <strong>NorgesGruppen:</strong> kombinerte rollene som UX-designer og Product Owner. Gjennomførte og
                  analyserte 40 dybdeintervjuer med brukere som grunnlag for designbeslutninger. Sammenstilte funnene til
                  brukersentrerte konsepter og wireframes. Eide produktbackloggen og fasiliterte grooming for å
                  prioritere funksjonalitet.
                </li>
                <li>
                  <strong>Datatilsynet:</strong> fasiliterte arbeidet med innholdsstrategi da veiledningen om GDPR ble
                  lansert første gang. Skrev brukervennlige tekster som gjorde komplisert regelverk forståelig.
                </li>
              </ul>

              <h3>UX-designer og smidig Product Owner — Pureservice</h3>
              <p class="role-dates">2013 – 2016</p>
              <ul>
                <li>Bygde verktøyet for IT-tjenestestyring opp på nytt fra grunnen, for web og mobil.</li>
                <li>Ledet tverrfaglige team i Oslo og Bangalore, med vekt på brukerinnsikt og produktbacklog.</li>
              </ul>

              <h3>UX-designer og smidig Product Owner — Pearson</h3>
              <p class="role-dates">2010 – 2013</p>
              <ul>
                <li>Designet og forvaltet et produkt for en læringsplattform (LMS) med over 10 millioner daglige brukere.</li>
                <li>Utviklet nye verktøy for prøver og innleveringer for studenter over hele verden.</li>
              </ul>

              <h3>Utvikler — Tieto Evry</h3>
              <p class="role-dates">1997 – 2004</p>
              <ul>
                <li>Frontend-utvikler med spesialisering i netthandelsprosjekter.</li>
              </ul>

              <h2>Utdanning og kurs</h2>
              <ul>
                <li>Sertifisering i prosjektledelse — Henley Business School, Storbritannia (2000–2001)</li>
                <li>Kommunikasjon og lederskap — Dale Carnegie (2015)</li>
              </ul>

              <h2>Ferdigheter og verktøy</h2>
              <p>
                <strong>Ferdigheter:</strong> UX/UI-design, produkteierskap (sertifisert), brukerinnsikt og brukertesting,
                smidige metoder, informasjonsarkitektur, design thinking, webanalyse, HTML/CSS, ITIL (sertifisert)
              </p>
              <p><strong>Verktøy:</strong> Figma, Sketch, Adobe XD, Miro, Jira, Azure DevOps, GitHub, Confluence</p>

              <h2>Språk</h2>
              <p>Norsk (morsmål), engelsk (profesjonelt nivå), koreansk (nybegynner)</p>
              </Fragment>
            ) : lang === 'ko' ? (
              <Fragment>
              <h2>경력 사항</h2>

              <h3>UX 디자이너, UX 리서처, 스크럼 마스터 — Felleskjøpet</h3>
              <p class="role-dates">2024 – 현재</p>
              <ul>
                <li>
                  <strong>멀티사이트 이커머스:</strong> Optimizely Headless CMS 기반 Felleskjøpet 이커머스 플랫폼의
                  리디자인과 지속적인 개발에 참여했으며, 2025년 12월에 출시했습니다.
                </li>
                <li>
                  <strong>사용자 인사이트:</strong> 정성 리서치와 GA4, Hotjar, 검색 데이터, 고객 서비스 인사이트를 결합해
                  사용자 니즈를 파악하고 개선 우선순위를 정했습니다.
                </li>
                <li>
                  <strong>인사이트 포럼:</strong> UX, 분석, SEO, 검색, 고객 서비스가 함께 발견을 공유하고 우선순위를
                  조율하는 협업 포럼을 만들고 이끌었습니다.
                </li>
                <li>
                  <strong>애자일 딜리버리:</strong> 프런트엔드, 백엔드, 디자인, 테스트 전반의 리파인먼트와 상세화를
                  진행하며, 큰 기능을 구현 가능한 작업으로 나누도록 팀을 도왔습니다.
                </li>
                <li>
                  <strong>제품 협업:</strong> 개발자, 디자이너, 이해관계자와 긴밀히 협력하며 사용자 니즈, 비즈니스 목표,
                  기술적 제약 사이의 균형을 맞췄습니다.
                </li>
              </ul>

              <h3>UX Lead 및 프로덕트 오너 — Experis, Anyshore</h3>
              <p class="role-dates">2021 – 현재</p>
              <ul>
                <li>
                  <strong>오슬로시:</strong> 접근성 테스트를 수행하고 WCAG 지침에 따른 접근성 개선 방안을 제시했습니다.
                </li>
                <li>
                  <strong>노르웨이 기상청:</strong> 말라위 날씨 앱 프로젝트의 UX/UI 디자인과 제품 오너십을 이끌며 사용자
                  리서치와 하이파이 디자인을 진행했습니다.
                </li>
                <li>
                  <strong>Buypass AS:</strong> 디자인 팀을 이끌고 디자인 전략을 수립했으며 리서치 저장소를 구축했습니다.
                </li>
                <li>
                  <strong>노르웨이 농업청:</strong> UI 디자인과 브랜드 리프레시를 진행하고 Figma 컴포넌트로 디자인
                  시스템을 만들었습니다.
                </li>
                <li>
                  <strong>노르웨이 국세청:</strong> 부서 전반의 핵심 성과 지표를 조사하며 관리자 40명을 인터뷰해 운영
                  효율을 높였습니다.
                </li>
              </ul>

              <h3>UX Lead 및 프로덕트 오너 — Mimiro</h3>
              <p class="role-dates">2019 – 2020</p>
              <ul>
                <li>원격으로 일하는 개발자 20명으로 구성된 팀의 UX 디자인과 제품 오너십을 이끌며 농업인을 위한 데이터 기반 도구를 만들었습니다.</li>
                <li>음향 분석, GPS, 자이로스코프, 머신러닝 등 첨단 기술을 활용해 식량 생산의 효율을 높였습니다.</li>
              </ul>

              <h3>시니어 UX 디자이너 (컨설턴트) — Northern Beat</h3>
              <p class="role-dates">2016 – 2019</p>
              <ul>
                <li>
                  <strong>노르웨이 국세청:</strong> 정보 구조 전략을 개발하고 적용했습니다. 사용자의 이해와 참여를 높이는
                  명확하고 간결한 문구를 작성했습니다.
                </li>
                <li>
                  <strong>NorgesGruppen:</strong> UX 디자인과 제품 오너 역할을 함께 맡았습니다. 디자인 결정의 근거가 된
                  심층 사용자 인터뷰 40건을 진행하고 분석했습니다. 리서치 결과를 종합해 사용자 중심의 콘셉트와
                  와이어프레임을 만들었습니다. 제품 백로그를 관리하고 기능 우선순위를 정하는 그루밍 세션을 진행했습니다.
                </li>
                <li>
                  <strong>노르웨이 개인정보보호청:</strong> GDPR 안내 자료의 첫 출시를 위한 콘텐츠 전략 수립을
                  진행했습니다. 복잡한 규정을 효과적으로 전달하는 사용자 친화적인 문구를 작성했습니다.
                </li>
              </ul>

              <h3>UX 디자이너 및 애자일 프로덕트 오너 — Pureservice</h3>
              <p class="role-dates">2013 – 2016</p>
              <ul>
                <li>IT 서비스 관리 도구를 웹과 모바일 플랫폼용으로 처음부터 다시 만들었습니다.</li>
                <li>오슬로와 방갈로르의 다기능 팀을 이끌며 사용자 리서치와 제품 백로그 관리에 집중했습니다.</li>
              </ul>

              <h3>UX 디자이너 및 애자일 프로덕트 오너 — Pearson</h3>
              <p class="role-dates">2010 – 2013</p>
              <ul>
                <li>일일 사용자가 1,000만 명이 넘는 학습 관리 시스템(LMS) 제품을 디자인하고 관리했습니다.</li>
                <li>전 세계 학생을 위한 새로운 시험 및 과제 제출 도구를 개발했습니다.</li>
              </ul>

              <h3>개발자 — Tieto Evry</h3>
              <p class="role-dates">1997 – 2004</p>
              <ul>
                <li>이커머스 프로젝트를 전문으로 하는 프런트엔드 개발자.</li>
              </ul>

              <h2>교육 및 연수</h2>
              <ul>
                <li>프로젝트 관리 자격 과정 — Henley Business School, 영국 (2000–2001)</li>
                <li>커뮤니케이션 및 리더십 교육 — Dale Carnegie (2015)</li>
              </ul>

              <h2>역량과 도구</h2>
              <p>
                <strong>역량:</strong> UX/UI 디자인, 제품 오너십(자격 보유), 사용자 리서치 및 테스트, 애자일 방법론, 정보
                구조, 디자인 씽킹, 웹 분석, HTML/CSS, ITIL(자격 보유)
              </p>
              <p><strong>도구:</strong> Figma, Sketch, Adobe XD, Miro, Jira, Azure DevOps, GitHub, Confluence</p>

              <h2>언어</h2>
              <p>노르웨이어(모국어), 영어(업무 수준), 한국어(초급)</p>
              </Fragment>
            ) : (
              <Fragment>
              <h2>Experience</h2>

              <h3>UX Designer, UX Researcher and Scrum Master — Felleskjøpet</h3>
              <p class="role-dates">2024 – Present</p>
              <ul>
                <li>
                  <strong>E-commerce multisite:</strong> worked on the redesign and continuous development of
                  Felleskjøpet's e-commerce platform on Optimizely Headless CMS, launched in December 2025.
                </li>
                <li>
                  <strong>User insight:</strong> combined qualitative research with GA4, Hotjar, search data and
                  customer-service insight to identify user needs and prioritise improvements.
                </li>
                <li>
                  <strong>Insight forum:</strong> established and led a cross-functional forum bringing together UX,
                  analytics, SEO, search and customer service to share findings and coordinate priorities.
                </li>
                <li>
                  <strong>Agile delivery:</strong> facilitated refinement and detailing across frontend, backend,
                  design and testing, helping the team turn larger features into implementable work.
                </li>
                <li>
                  <strong>Product collaboration:</strong> worked closely with developers, designers and stakeholders
                  to balance user needs, business goals and technical constraints.
                </li>
              </ul>

              <h3>UX Lead &amp; Product Owner — Experis, Anyshore</h3>
              <p class="role-dates">2021 – Present</p>
              <ul>
                <li>
                  <strong>Oslo Kommune:</strong> conducted accessibility testing and provided accessibility
                  recommendations based on WCAG guidelines.
                </li>
                <li>
                  <strong>Norwegian Meteorological Institute:</strong> led UX/UI design and product ownership for a
                  weather app project in Malawi, conducting user research and creating high-fidelity design.
                </li>
                <li>
                  <strong>Buypass AS:</strong> managed the design team, set design strategy, and built a research
                  repository.
                </li>
                <li>
                  <strong>Norwegian Directorate of Agriculture:</strong> developed UI design and a brand refresh,
                  creating a design system with Figma components.
                </li>
                <li>
                  <strong>Norwegian Tax Administration:</strong> conducted research on key performance metrics across
                  departments, interviewing 40 managers to improve operational efficiency.
                </li>
              </ul>

              <h3>UX Lead and Product Owner — Mimiro</h3>
              <p class="role-dates">2019 – 2020</p>
              <ul>
                <li>Led UX design and product ownership for a team of 20 remote developers, creating data-driven tools for farmers.</li>
                <li>Utilised advanced technologies including sound analytics, GPS, gyroscope, and machine learning to enhance food production efficiency.</li>
              </ul>

              <h3>Senior UX Designer (Consultant) — Northern Beat</h3>
              <p class="role-dates">2016 – 2019</p>
              <ul>
                <li>
                  <strong>Norwegian Tax Administration:</strong> developed and implemented information architecture
                  strategies. Crafted clear and concise copy to enhance user understanding and engagement.
                </li>
                <li>
                  <strong>NorgesGruppen:</strong> combining UX design and product ownership responsibilities.
                  Conducted and analysed 40 in-depth user interviews to inform design decisions. Synthesised research
                  findings to create user-centred concepts and wireframes. Managed the product backlog and
                  facilitated grooming sessions to prioritise features.
                </li>
                <li>
                  <strong>Norwegian Data Protection Authority (DPA):</strong> facilitated content strategy development
                  for the initial launch of GDPR compliance materials. Authored user-friendly copy to effectively
                  communicate complex regulatory information.
                </li>
              </ul>

              <h3>UX Designer and Agile Product Owner — Pureservice</h3>
              <p class="role-dates">2013 – 2016</p>
              <ul>
                <li>Rebuilt the IT service management tool from the ground up for web and mobile platforms.</li>
                <li>Managed cross-functional teams in Oslo and Bangalore, focusing on user research and product backlog management.</li>
              </ul>

              <h3>UX Designer and Agile Product Owner — Pearson</h3>
              <p class="role-dates">2010 – 2013</p>
              <ul>
