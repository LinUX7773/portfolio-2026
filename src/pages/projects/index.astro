---
import { getCollection } from 'astro:content';
import ProjectRow from '../../components/ProjectRow.astro';
import Flower from '../../components/decor/Flower.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="UX case studies by Lin Bele Jacobsen."
>
  <main id="main" class="page-main">
    <div class="page-grid projects-page">
      <header class="page-grid__reading page-head">
        <p class="kicker">Work</p>
        <h1>Projects</h1>
        <p>
          I love making complicated tasks feel surprisingly easy. Here are a few projects where I got to do just that.
        </p>
      </header>

      <div class="page-grid__reading list">
        {
          projects.map((project, index) => (
            <ProjectRow
              href={`/projects/${project.id}`}
              index={index + 1}
              title={project.data.title}
              summary={project.data.summary}
              topics={project.data.topics}
            />
          ))
        }
      </div>

      <div class="projects-page__decor" aria-hidden="true">
        <Flower name="daisy" />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .projects-page {
    position: relative;
  }

  .projects-page__decor {
    position: absolute;
    z-index: 0;
    bottom: -1.75rem;
    right: -1rem;
    height: clamp(5.5rem, 11vw, 8rem);
    pointer-events: none;
  }

  .page-head {
    margin-bottom: var(--space-5);
  }

  h1 {
    margin: 0.25em 0 0.45em;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .page-head p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
