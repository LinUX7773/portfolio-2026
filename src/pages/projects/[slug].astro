---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Flower from '../../components/decor/Flower.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, client, team, topics, heroImage, heroImageAlt, heroCaption } =
  project.data;

// Display-only: compact the comma-separated facts onto one line with a
// middle dot instead of commas. The underlying fact strings in the
// frontmatter are untouched — this only changes how they're rendered.
const compact = (value: string) => value.replace(/,\s*/g, ' · ');

const meta = [
  role ? ['Role', compact(role)] : null,
  client ? ['Client', client] : null,
  year ? ['Year', year] : null,
  team ? ['Team', compact(team)] : null,
].filter((item): item is [string, string] => item !== null);
---

<BaseLayout title={title} description={summary}>
  <main id="main" class="page-main">
    <article class="case">
      <header class="case__header site-frame">
        <p class="kicker">
          <a href="/projects">Projects</a>
        </p>
        <h1>{title}</h1>
        <p class="case__summary">{summary}</p>
        {
          meta.length > 0 && (
            <dl class="meta">
              {meta.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          topics.length > 0 && (
            <p class="topics">{topics.join(' · ')}</p>
          )
        }
      </header>

      <div class="hero site-frame">
        <figure>
          {
            heroImage ? (
              <img src={heroImage} alt={heroImageAlt ?? ''} loading="lazy" decoding="async" />
            ) : (
              <div class="media-ph" role="img" aria-label="Placeholder for the project hero image">
                <p>Hero image placeholder</p>
              </div>
            )
          }
          {heroCaption && <figcaption>{heroCaption}</figcaption>}
        </figure>
      </div>

      <div class="case__body page-grid">
        <div class="prose">
          <Content />
        </div>
        <div class="case__end-decor" aria-hidden="true">
          <Flower name="lily-of-the-valley" />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .case__header {
    margin-bottom: var(--space-4);
  }

  .kicker a {
    text-decoration: none;
  }

  h1 {
    margin: 0.3em 0 0.45em;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .case__summary {
    margin: 0;
    max-width: 34rem;
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.4;
  }

  /*
   * A calm horizontal metadata strip rather than four heavy blocks:
   * no bold anywhere (hierarchy comes from the small uppercase label vs
   * the larger regular-weight value), and at desktop all four groups
   * share one row with widths weighted to what they typically hold
   * (role and team read as compact lists and need more room; year is
   * always short). .case__header no longer caps its own width, so this
   * row can use the full case-study header width instead of being
   * squeezed into the narrow reading measure.
   */
  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 1.5rem;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .meta dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
  }

  .topics {
    margin: 1.1rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  .hero figure {
    margin: 0;
  }

  .hero figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .case__body {
    position: relative;
    row-gap: 0;
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  /*
   * The flower's height used to scale up to 9rem at wide viewports
   * (clamp(6rem, 12vw, 9rem)), while its vertical anchor (bottom) stayed
   * fixed. On a case study that ends in a full-width image with little
   * or no trailing text — Service management is the one this bites,
   * since its last figure is media-wide with only a short caption — the
   * flower grew tall enough at ~1150–1550px widths that its own top
   * (the blossoms) reached up into the bottom edge of that image. A
   * fixed, smaller height removes the growth that caused it, at every
   * width, without needing to shift the flower's anchored position
   * (which would either still clip it, at a shift toward the image, or
   * push it down into the footer, at a shift away).
   */
  .case__end-decor {
    position: absolute;
    z-index: 0;
    bottom: -0.5rem;
    left: calc(50% + (var(--reading-w) / 2) + 1.5rem);
    height: 6rem;
    pointer-events: none;
  }

  @media (max-width: 1099px) {
    .case__end-decor {
      left: auto;
      right: 0;
    }
  }

  @media (min-width: 768px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .meta {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.2fr) minmax(0, 0.6fr) minmax(0, 2fr);
      column-gap: 2rem;
      align-items: start;
    }
  }
</style>
