---
import Flower from '../components/decor/Flower.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mentoring"
  description="Lin Bele Jacobsen mentors junior UX designers and product managers through ADPList."
>
  <main id="main" class="page-main">
    <div class="page-grid mentoring-page">
      <div class="page-grid__reading mentoring__copy">
        <p class="kicker">Mentoring</p>
        <div class="mentoring__title-row">
          <div class="mentoring__decor" aria-hidden="true">
            <Flower name="bluebell" />
          </div>
          <h1>The young and ambitious</h1>
        </div>

        <dl class="meta">
          <div>
            <dt>Roles</dt>
            <dd>Mentor</dd>
          </div>
          <div>
            <dt>Sessions</dt>
            <dd>104</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>Jan 2022 – ongoing</dd>
          </div>
          <div>
            <dt>Company</dt>
            <dd>ADPList</dd>
          </div>
        </dl>
      </div>

      <div class="page-grid__reading mentoring__intro">
        <div class="prose">
          <h2>My key takeaways</h2>
          <p>Being a mentor has been the most rewarding and inspiring move of my career.</p>
        </div>

        <figure class="mentoring__card">
          <img
            src="/assets/mentoring/adplist-profile-card.png"
            alt="An ADPList mentor card for Lin Bele Jacobsen: her timezone, her role as UX Lead at Experis, 108 sessions and 35 reviews, with a &quot;Book a session with me&quot; button."
            width="1004"
            height="770"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="page-grid__reading mentoring__rest">
        <div class="prose">
          <p>
            The young and highly ambitious mentees bravely share their problems and concerns. I ask questions and
            help them compartmentalise their concerns and lay a strategy for solving problems.
          </p>
          <p>We often discuss how to communicate efficiently.</p>
          <p>I also do mock interviews and help with portfolio reviews.</p>

          <figure>
            <img
              src="/assets/mentoring/adplist-full-profile.png"
              alt="Lin Bele Jacobsen's full ADPList profile page: an About Me summary, community statistics showing 4,605 minutes mentored and 104 sessions completed, profile insight badges including Clear Communicator, Interacts with newbies, Perfect Presence and Top achiever: Lead, and a list of available session types."
              width="3158"
              height="2428"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <p>
            For the past 3 years I have been working as a mentor for junior UX-UI designers and PMs. Being a
            mentor is fun and rewarding. It has re-sparked my passion for design and product management. As a
            mentor, I offer tips on how to get into the industry and what to expect. I help with CV, portfolio,
            and interview training.
          </p>
          <p>
            I also have quite a few regular mentees who want someone to kick a ball with when being the only
            designer in a company. I learned so much from these sessions and I am impressed by ADPList for
            facilitating all this for free. No money changes hands, only ideas and inspiration. This activity
            happens during evenings.
          </p>

          <figure>
            <img
              src="/assets/mentoring/mentoring-stats.png"
              alt="An ADPList community-statistics card: 4,605 minutes mentored, 104 1:1 bookings, and 25 countries mentored, with a breakdown table led by Norway (38), the United Kingdom (16), Poland (7) and India (6)."
              width="1836"
              height="512"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <figure>
            <img
              src="/assets/mentoring/review-michetti-depaemelaere-christian.png"
              alt="Three ADPList reviews. Stephen Michetti, Digital Product Designer (Freelance), 22 July 2024: &quot;Lin was very attentive and helpful in hearing me out and giving me direction. I'll gladly stay in touch and let her know how I get along.&quot; Ellen Depaemelaere, student at University of Antwerp, 2 July 2024: &quot;Miss Jacobsen has profound knowledge in various IT fields, but knows very well how to distinguish them... She came across as very alert, made sure she understood the whole picture and showed patience.&quot; Christian, UX Manager at BrightLocal, 24 June 2024: &quot;Lin had a great perspective on working in tech and remotely. It was interesting to hear about the challenges out there right now and also get some ideas on how to show and add value. I came away feeling inspired.&quot;"
              width="1576"
              height="1926"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <figure>
            <img
              src="/assets/mentoring/review-tan-ghasemian.png"
              alt="Two ADPList reviews. Erin Tan, UX Designer looking for opportunities, 20 February 2024: &quot;I always love our sessions together! They are always encouraging and invigorating because Lin shows great passion for her work and provides structure and actionable tips.&quot; Sara Ghasemian, product design at Farakaranet, 12 February 2024: &quot;After our meeting, I'm thankful for my mentor's encouragement and positive attitude.&quot;"
              width="1700"
              height="1062"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <figure>
            <img
              src="/assets/mentoring/review-marr-kraus-rui.png"
              alt="Three ADPList reviews. Alissa Marr, Product UX Designer on the founding team at trender.ai, 20 December 2023: &quot;My session with Lin was really uplifting. We talked a lot about our careers and the different projects we have worked on, our processes and our pivots... The portfolio review was empowering and also very helpful as she noted detailed additives I might want to try. Overall a lovely chat.&quot; Marina Kraus, Senior UX/UI Designer at Urbio, 14 December 2023: &quot;I had a great conversation with Lin. She gave me extremely good tips on how to best incorporate UXR into my workflow as a solo designer without spending too much time on it... I can highly recommend her as someone to talk to about your work as a UX designer.&quot; Yaowei Rui, UX Designer at Food For Thought, 13 November 2023: &quot;Lin is a very genuine mentor with many years of UX experience. She provided me with honest feedback on my resume and portfolio, approaching it with a clear, constructive UX mindset. Thank you, Lin!&quot;"
              width="1658"
              height="1908"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .mentoring-page {
    row-gap: var(--space-4);
  }

  /*
   * Grid, not flex-wrap: the heading text is long enough to need two lines
   * on its own at large sizes, and a wrapping flex row would then decide
   * (based on the H1's unwrapped max-content width, before any shrinking)
   * that the flower doesn't fit beside it and push it onto its own line
   * entirely above the heading. A two-column grid has no such ambiguity —
   * the flower keeps its own auto-sized column and the heading wraps
   * freely within the remaining column.
   *
   * The flower used to stretch to match the heading's own wrapped height
   * (via align-self: stretch + aspect-ratio on .mentoring__decor). That
   * put the grid row's auto-height in a circular dependency with the
   * flower's own intrinsic sizing, and at some viewport widths — where
   * the heading wraps to two lines but the row was still sized as if it
   * were one — the row collapsed short and the next block (the meta grid)
   * rendered on top of the second heading line and the bottom of the
   * flower. A fixed height (matching the pattern already used on the
   * About and Resume pages) has no such dependency.
   */
  .mentoring__title-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    column-gap: 1.25rem;
  }

  .mentoring__decor {
    height: clamp(5.5rem, 11vw, 9rem);
    pointer-events: none;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .meta {
    display: grid;
    gap: 1rem;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .meta dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .mentoring__intro .prose {
    margin-top: var(--space-5);
  }

  /*
   * Experimental placement: the contact card sits beside the first "My
   * key takeaways" paragraph instead of inline in the reading column.
   * At desktop it's taken out of flow (position: absolute, anchored to
   * .mentoring__intro) so its own height never affects the row height —
   * growing or shrinking the card can't push the rest of the page's
   * content down, and the reading column's text isn't constrained by it
   * either. Below the 1100px rail breakpoint there's no rail to float
   * into, so it drops back into normal flow, stacked below the text.
   */
  .mentoring__intro {
    position: relative;
  }

  .mentoring__card {
    margin: 0;
    width: 100%;
    max-width: 14.04rem;
  }

  /*
   * The intro paragraph and the next section's opening paragraph each sit
   * in their own .prose block (split across grid rows so the contact card
   * can share a row with just the intro text). Browser default paragraph
   * margins aren't touched by the .prose > * + * rule for a first/last
   * child with no sibling on that side, so they were leaking through on
   * top of the grid's own row-gap — stacking into a gap roughly 3x the
   * normal paragraph spacing seen elsewhere on the page. Zeroing them
   * leaves just the intentional row-gap between the two sections.
   */
  .mentoring__intro .prose p {
    margin-bottom: 0;
  }

  .mentoring__rest .prose > p:first-child {
    margin-top: 0;
  }

  @media (min-width: 1100px) {
    .mentoring__card {
      position: absolute;
      top: 9.4rem;
      left: calc(100% + var(--gutter));
    }
  }

  /*
   * Below the rail breakpoint the card drops into normal flow directly
   * after .prose. It picked up its gap from the intro paragraph's own
   * (unintentional) default margin-bottom — now zeroed out above — so it
   * needs its own explicit spacing here instead.
   */
  @media (max-width: 1099px) {
    .mentoring__card {
      margin-top: var(--space-4);
    }
  }

  @media (min-width: 500px) {
    .meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
