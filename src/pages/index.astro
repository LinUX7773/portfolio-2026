---
import { getCollection } from 'astro:content';
import ProjectRow from '../components/ProjectRow.astro';
import Flower from '../components/decor/Flower.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const featured = projects.filter((project) => project.data.featured);
---

<BaseLayout
  description="Portfolio of Lin Bele Jacobsen, senior UX designer and product owner based in Norway."
>
  <main id="main">
    <section class="masthead" aria-labelledby="name">
      <div class="page-grid masthead__grid">
        <div class="page-grid__wide masthead__heading">
          <p class="kicker">{site.role}</p>
          <div class="masthead__title-row">
            <h1 id="name">{site.name}</h1>
            <div class="masthead__decor" aria-hidden="true">
              <Flower name="lonicera" />
            </div>
          </div>
          <p class="lede">
            Designing solutions that balance user needs &amp; business goals — because it’s about more than just looking good!
          </p>
        </div>
      </div>
    </section>

    <section class="intro page-grid" aria-labelledby="intro-heading">
      <div class="page-grid__reading intro__body">
        <h2 id="intro-heading" class="kicker">Selected work</h2>
        <p class="intro__text">
          I love making complicated tasks feel surprisingly easy. Here are a few projects where I got to do just that.
        </p>
        <p>
          <a href="/projects">View some of my projects<span aria-hidden="true"> →</span></a>
        </p>
      </div>
      <figure class="page-grid__rail-right intro__media">
        <img
          src="/assets/home/workshop-session.png"
          alt="Three colleagues gathered around a whiteboard covered in colour-coded sticky notes during a workshop session."
          width="2880"
          height="2288"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section class="work page-grid" aria-labelledby="work-heading">
      <div class="page-grid__reading work__head">
        <h2 id="work-heading">Projects</h2>
      </div>
      <div class="page-grid__reading work__list">
        {
          featured.map((project, index) => (
            <ProjectRow
              href={`/projects/${project.id}`}
              index={index + 1}
              title={project.data.title}
              summary={project.data.summary}
              topics={project.data.topics}
            />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .masthead {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2.25rem, 5vw, 4rem);
  }

  .masthead__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
  }

  .masthead__decor {
    flex-shrink: 0;
    height: clamp(5.5rem, 11vw, 9rem);
    pointer-events: none;
  }

  /*
   * At desktop widths the masthead composition (kicker, H1, flower, lede)
   * keeps the same internal layout but is sized to a wide-but-not-full-bleed
   * box and centred in the three-zone grid, so it reads as flanked by rails
   * rather than pinned to the left site gutter. Same width formula as the
   * centred media-wide case-study images: reading column + one rail's
   * worth of extra width, distributed evenly on both sides instead of
   * only ever growing from the left edge.
   */
  @media (min-width: 1100px) {
    .masthead__heading {
      width: calc((var(--reading-w) + 100%) / 2 - var(--gutter));
      margin-inline: auto;
    }
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.02;
  }

  .lede {
    margin: 0;
    margin-top: var(--space-5);
    max-width: 42ch;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .intro {
    row-gap: var(--space-5);
    padding-block: var(--space-6) 3.3rem;
    border-top: 1px solid var(--rule);
  }

  .intro__media {
    margin: 0;
  }

  @media (min-width: 1100px) {
    .intro__media {
      transform: translateX(-2.5rem);
    }
  }

  .intro__text {
    margin: 0.9rem 0 1.1rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .intro a {
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  .work {
    row-gap: var(--space-4);
    padding-block: 3.3rem var(--space-6);
  }

  .work__head {
    display: grid;
    gap: 0.75rem;
  }

  .work h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .lede {
      max-width: 34ch;
    }
  }
</style>
