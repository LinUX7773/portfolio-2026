---
import { site } from '../data/site';
import { getLang, navItems, t } from '../i18n';

const lang = getLang(Astro.url);
const copy = t(lang);
const nav = navItems(lang);

// Lets the address wrap before the @ on narrow screens instead of
// forcing the contact column wider than the space beside the menu.
const [emailUser, emailDomain] = site.email.split('@');
---

<footer class="site-footer">
  <div class="site-footer__inner site-frame">
    <div class="site-footer__groups">
      <div>
        <p class="kicker">{copy.contact}</p>
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__email"><a href={`mailto:${site.email}`}>{emailUser}<wbr />@{emailDomain}</a></p>
        <p class="site-footer__note">{copy.footerNote}</p>
      </div>
      <nav aria-label={copy.footerNav}>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--chrome-bg);
    color: var(--chrome-ink);
    border-top: 1px solid var(--chrome-rule);
    padding-block: var(--space-5);
  }

  .site-footer .kicker {
    color: var(--chrome-ink-soft);
  }

  .site-footer a:hover {
    color: var(--chrome-hover);
  }

  .site-footer a:focus-visible {
    outline-color: var(--chrome-ink);
  }

  /*
   * Contact and menu sit side by side at every width: the menu column
   * takes only the width its longest link needs, and the contact text
   * wraps in the remaining space rather than pushing the menu below it.
   */
  .site-footer__groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-3);
  }

  .site-footer__groups > div {
    overflow-wrap: break-word;
  }

  .site-footer__name {
    margin: 0.4rem 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.25;
  }

  .site-footer__email {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  .site-footer nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    text-align: right;
  }

  .site-footer nav a {
    display: inline-block;
    padding-block: 0.25rem;
  }

  .site-footer a {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__note {
    margin: 0.9rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--chrome-ink-soft);
  }

  @media (min-width: 768px) {
    .site-footer__groups {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-4);
    }
  }

  /*
   * Centre the two-group composition (Contact + navigation) within the
   * footer at desktop widths, same rail breakpoint and the same
   * centred-wide formula used for the masthead and the media-wide
   * case-study images: reading column + one rail's worth of extra width,
   * distributed evenly rather than the content simply filling the full
   * site-frame from the left gutter to the right gutter.
   */
  @media (min-width: 1100px) {
    .site-footer__groups {
      width: calc((var(--reading-w) + 100%) / 2 - var(--gutter));
      margin-inline: auto;
    }
  }
</style>
