---
// Small decorative flags for the language switcher. The language name
// next to the flag carries the meaning; the flag itself is hidden from
// assistive technology.
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{
  lang === 'ko' ? (
    <svg class="lang-flag" viewBox="0 0 36 24" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <rect width="36" height="24" fill="#fff" />
      <g transform="rotate(33.69 18 12)"><path d="M12 12a6 6 0 0 1 12 0a3 3 0 0 1-6 0a3 3 0 0 0-6 0z" fill="#cd2e3a"/><path d="M12 12a3 3 0 0 0 6 0a3 3 0 0 1 6 0a6 6 0 0 1-12 0z" fill="#0047a0"/></g>
      <g transform="translate(9.263 6.176) rotate(-56.309932474020215)" fill="#000"><rect x="-3" y="-2.250" width="6" height="1" /><rect x="-3" y="-0.500" width="6" height="1" /><rect x="-3" y="1.250" width="6" height="1" /></g>
      <g transform="translate(26.737 17.824) rotate(-56.309932474020215)" fill="#000"><rect x="-3" y="-2.250" width="2.625" height="1" /><rect x="0.375" y="-2.250" width="2.625" height="1" /><rect x="-3" y="-0.500" width="2.625" height="1" /><rect x="0.375" y="-0.500" width="2.625" height="1" /><rect x="-3" y="1.250" width="2.625" height="1" /><rect x="0.375" y="1.250" width="2.625" height="1" /></g>
      <g transform="translate(26.737 6.176) rotate(56.309932474020215)" fill="#000"><rect x="-3" y="-2.250" width="2.625" height="1" /><rect x="0.375" y="-2.250" width="2.625" height="1" /><rect x="-3" y="-0.500" width="6" height="1" /><rect x="-3" y="1.250" width="2.625" height="1" /><rect x="0.375" y="1.250" width="2.625" height="1" /></g>
      <g transform="translate(9.263 17.824) rotate(56.309932474020215)" fill="#000"><rect x="-3" y="-2.250" width="6" height="1" /><rect x="-3" y="-0.500" width="2.625" height="1" /><rect x="0.375" y="-0.500" width="2.625" height="1" /><rect x="-3" y="1.250" width="6" height="1" /></g>
    </svg>
  ) : lang === 'nb' ? (
    <svg class="lang-flag" viewBox="0 0 22 16" aria-hidden="true" focusable="false">
      <rect width="22" height="16" fill="#ba0c2f" />
      <path d="M6 0h4v16H6zM0 6h22v4H0z" fill="#fff" />
      <path d="M7 0h2v16H7zM0 7h22v2H0z" fill="#00205b" />
    </svg>
  ) : (
    <svg
      class="lang-flag"
      viewBox="0 0 60 30"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="60" height="30" fill="#012169" />
      <path d="M0 0l60 30M60 0L0 30" stroke="#fff" stroke-width="6" />
      <path d="M0 0l60 30M60 0L0 30" stroke="#c8102e" stroke-width="2" />
      <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
      <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
    </svg>
  )
}

<style>
  .lang-flag {
    display: block;
    flex-shrink: 0;
    width: 1.3em;
    height: 0.95em;
    max-width: none;
    outline: 1px solid rgb(29 25 21 / 0.15);
    outline-offset: 0;
  }
</style>
