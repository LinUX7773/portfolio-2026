---
import LangFlag from './decor/LangFlag.astro';
import { site } from '../data/site';
import { getLang, languages, localePath, navItems, stripLang, t } from '../i18n';

const lang = getLang(Astro.url);
const copy = t(lang);
const nav = navItems(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pagePath = stripLang(Astro.url.pathname);
const languageNames = { nb: 'Norsk', en: 'English' } as const;
---

<header class="site-header">
  <div class="site-header__inner site-frame">
    <a class="wordmark" href={localePath(lang, '/')} aria-label={`${site.name}, ${copy.home}`}>{site.name}</a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav language-nav"
      data-label-open={copy.menu}
      data-label-close={copy.close}
    >
      {copy.menu}
    </button>

    <nav class="nav" id="primary-nav" aria-label={copy.primaryNav}>
      <ul>
        {
          nav.map((item) => {
            const current =
              item.href.endsWith('/projects')
                ? path === item.href || path.startsWith(`${item.href}/`)
                : path === item.href;
            return (
              <li>
                <a href={item.href} aria-current={current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <nav class="lang-switch" id="language-nav" aria-label={copy.language}>
      <ul>
        {
          languages.map((code) => (
            <li>
              <a
                href={localePath(code, pagePath)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
              >
                <LangFlag lang={code} />
                {languageNames[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');

  if (toggle instanceof HTMLElement) toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.textContent = (open ? toggle.dataset.labelOpen : toggle.dataset.labelClose) ?? '';
    header?.classList.toggle('menu-open', !open);
  });

  // Shadow only once content is scrolled underneath the sticky header.
  const updateScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 0);
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    transition: box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 18px -8px rgb(29 25 21 / 0.22);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: var(--header-h);
    gap: var(--space-2) var(--space-3);
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.1;
    white-space: nowrap;
    text-decoration: none;
  }

  .wordmark:hover {
    color: inherit;
  }

  .menu-toggle {
    margin: 0;
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .nav ul,
  .lang-switch ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a,
  .lang-switch a {
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  /*
   * Language switch: flag + language name (in its own language) for both
   * options. The current language is marked with the same underline as
   * the current page in the menu, not by colour alone.
   */
  .lang-switch ul {
    display: flex;
    gap: var(--space-3);
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.35rem;
    color: var(--ink-soft);
  }

  .lang-switch a:hover {
    color: var(--terracotta);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  @media (max-width: 1023px) {
    .site-header__inner {
      min-height: 3.5rem;
    }

    .nav,
    .lang-switch {
      display: none;
      flex-basis: 100%;
    }

    .menu-open .nav,
    .menu-open .lang-switch {
      display: block;
    }

    .lang-switch {
      margin-top: 0.25rem;
      padding-block: 0.75rem 1rem;
      border-top: 1px solid var(--rule);
    }

    .nav li + li {
      margin-top: 0.85rem;
    }
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }

    .nav {
      display: block;
      margin-left: auto;
    }

    .lang-switch {
      padding-left: var(--space-3);
      border-left: 1px solid var(--rule);
    }

    .nav ul {
      display: flex;
      gap: clamp(1rem, 2.4vw, 2rem);
    }
  }
</style>
