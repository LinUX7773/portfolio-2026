---
import LangFlag from './decor/LangFlag.astro';
import { site } from '../data/site';
import { getLang, languages, localePath, navItems, stripLang, t } from '../i18n';

const lang = getLang(Astro.url);
const copy = t(lang);
const nav = navItems(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pagePath = stripLang(Astro.url.pathname);
const languageNames = { nb: 'Norsk', en: 'English' } as const;
---

<header class="site-header">
  <div class="site-header__inner site-frame">
    <a class="wordmark" href={localePath(lang, '/')} aria-label={`${site.name}, ${copy.home}`}>{site.name}</a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-label-open={copy.menu}
      data-label-close={copy.close}
    >
      {copy.menu}
    </button>

    <nav class="nav" id="primary-nav" aria-label={copy.primaryNav}>
      <ul>
        {
          nav.map((item) => {
            // "page" for the page itself, "true" for its section (a case
            // study sits inside Projects but isn't the Projects page).
            const current =
              path === item.href
                ? 'page'
                : item.href.endsWith('/projects') && path.startsWith(`${item.href}/`)
                  ? 'true'
                  : undefined;
            return (
              <li>
                <a href={item.href} aria-current={current}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!--
      Language switch as a disclosure: a button showing the current flag
      opens a short list of language links. Without JavaScript the list is
      simply shown and the button stays hidden.
    -->
    <nav class="lang-switch" aria-label={copy.language}>
      <button
        class="lang-switch__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="language-list"
        aria-label={`${copy.language}: ${languageNames[lang]}`}
        hidden
      >
        <LangFlag lang={lang} />
        <svg class="lang-switch__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
          <path d="M1.5 1.75 6 6.25l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <ul class="lang-switch__list" id="language-list">
        {
          languages.map((code) => (
            <li>
              <a
                href={localePath(code, pagePath)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
              >
                <LangFlag lang={code} />
                {languageNames[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');

  const setMenu = (open: boolean) => {
    if (!(toggle instanceof HTMLElement)) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    header?.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

  const langSwitch = header?.querySelector('.lang-switch');
  const langToggle = langSwitch?.querySelector('.lang-switch__toggle');
  const langList = langSwitch?.querySelector('.lang-switch__list');

  const setLang = (open: boolean) => {
    if (!(langToggle instanceof HTMLElement) || !(langList instanceof HTMLElement)) return;
    langToggle.setAttribute('aria-expanded', String(open));
    langList.hidden = !open;
  };

  if (langToggle instanceof HTMLElement && langList instanceof HTMLElement) {
    langToggle.hidden = false;
    langList.hidden = true;
    langSwitch?.classList.add('is-enhanced');
    langToggle.addEventListener('click', () => setLang(langToggle.getAttribute('aria-expanded') !== 'true'));

    // Close when focus or a click moves anywhere outside the switch.
    langSwitch?.addEventListener('focusout', (event) => {
      if (!langSwitch.contains(event.relatedTarget as Node | null)) setLang(false);
    });
    document.addEventListener('click', (event) => {
      if (!langSwitch?.contains(event.target as Node)) setLang(false);
    });
  }

  // Escape closes whichever is open (language list first, then the mobile
  // menu) and returns focus to the button that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (langToggle instanceof HTMLElement && langToggle.getAttribute('aria-expanded') === 'true') {
      setLang(false);
      langToggle.focus();
    } else if (toggle instanceof HTMLElement && toggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // Shadow only once content is scrolled underneath the sticky header.
  const updateScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 0);
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    transition: box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 18px -8px rgb(29 25 21 / 0.22);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: var(--header-h);
    gap: var(--space-2) var(--space-3);
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.1;
    white-space: nowrap;
    text-decoration: none;
  }

  .wordmark:hover {
    color: inherit;
  }

  .menu-toggle {
    margin: 0;
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .nav ul,
  .lang-switch ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Padding keeps every menu target at least 24px tall (WCAG 2.5.8). */
  .nav a,
  .lang-switch a {
    display: inline-block;
    padding-block: 0.35rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .nav a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  /*
   * Language switch. The button shows the current flag and a chevron; the
   * list holds flag + language name (in its own language) for both
   * options, with the current one underlined, not marked by colour alone.
   */
  .lang-switch {
    position: relative;
  }

  .lang-switch__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin: 0;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-size: var(--step--1);
    cursor: pointer;
  }

  .lang-switch__toggle[hidden] {
    display: none;
  }

  .lang-switch__toggle:hover {
    color: var(--terracotta);
  }

  .lang-switch__chevron {
    width: 0.7rem;
    height: auto;
    transition: transform 0.2s ease;
  }

  .lang-switch__toggle[aria-expanded='true'] .lang-switch__chevron {
    transform: rotate(180deg);
  }

  .lang-switch__list {
    display: flex;
    gap: var(--space-3);
  }

  .lang-switch.is-enhanced .lang-switch__list {
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 0;
    z-index: 30;
    flex-direction: column;
    gap: 0;
    min-width: 9.5rem;
    padding-block: 0.35rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    box-shadow: 0 6px 18px -8px rgb(29 25 21 / 0.22);
  }

  .lang-switch__list[hidden] {
    display: none;
  }

  .lang-switch a {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-soft);
  }

  .lang-switch.is-enhanced a {
    padding: 0.5rem 0.9rem;
  }

  .lang-switch a:hover {
    color: var(--terracotta);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  @media (max-width: 1023px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: var(--space-2);
      row-gap: 0;
      min-height: 3.5rem;
    }

    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    /*
     * The name and the menu button get the full row height themselves, so
     * they stay vertically centred in the same place when the open menu
     * makes the header taller.
     */
    .wordmark,
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      min-height: 3.5rem;
    }

    .nav {
      display: none;
      padding-bottom: 1rem;
    }

    .menu-open .nav {
      display: block;
    }

    .nav li + li {
      margin-top: 0.3rem;
    }
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }

    .nav {
      display: block;
      margin-left: auto;
    }

    .lang-switch {
      padding-left: var(--space-3);
      border-left: 1px solid var(--rule);
    }

    .nav ul {
      display: flex;
      gap: clamp(1rem, 2.4vw, 2rem);
    }
  }
</style>
