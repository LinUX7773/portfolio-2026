---
import { getLang, t } from '../i18n';

interface Props {
  href: string;
  title: string;
  summary: string;
  topics?: string[];
}

const { href, title, summary, topics = [] } = Astro.props;
const copy = t(getLang(Astro.url));
---

<article class="project-row">
  <h2 class="project-row__title">
    <a href={href}>{title}</a>
  </h2>
  <p class="project-row__summary">{summary}</p>
  {
    topics.length > 0 && (
      <p class="project-row__topics">{topics.join(' · ')}</p>
    )
  }
  <p class="project-row__cta">
    <a href={href}>
      {copy.readCaseStudy}<span aria-hidden="true"> →</span>
      <span class="visually-hidden"> — {title}</span>
    </a>
  </p>
</article>

<style>
  .project-row {
    border-top: 1px solid var(--rule);
    padding-block: 1.65rem;
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--rule);
  }


  .project-row__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .project-row__title a {
    color: inherit;
    text-decoration: none;
  }

  .project-row__title a:hover,
  .project-row__title a:focus-visible {
    color: var(--terracotta);
  }

  .project-row__summary {
    margin: 0.45rem 0 0;
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .project-row__topics {
    margin: 0.45rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink);
  }

  .project-row__cta {
    margin: 0.85rem 0 0;
  }

  .project-row__cta a {
    display: inline-block;
    padding-block: 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.28em;
    color: var(--wine);
  }

  .project-row__cta a:hover,
  .project-row__cta a:focus-visible {
    color: var(--terracotta);
  }

</style>
